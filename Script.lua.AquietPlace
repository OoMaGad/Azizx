---------------------------------------------------------
-- ESP FUNCTIONS (WITH DISTANCE)
---------------------------------------------------------
local function removeESP(model, tagType)
    if not model then return end
    local hl = model:FindFirstChild(tagType .. "_ESP")
    if hl then hl:Destroy() end
    local bb = model:FindFirstChild(tagType .. "_Tag")
    if bb then bb:Destroy() end
end

local function applyESP(model, color, displayName, tagType)
    if not model or not model.Parent then return end
    
    local hlName = tagType .. "_ESP"
    local tagName = tagType .. "_Tag"

    local hl = model:FindFirstChild(hlName)
    if not hl then
        hl = Instance.new("Highlight")
        hl.Name = hlName
        hl.FillColor = color
        hl.FillTransparency = 0.4
        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
        hl.OutlineTransparency = 0
        hl.Parent = model
    end

    local targetPart = model:FindFirstChild("Head") 
        or model:FindFirstChild("HumanoidRootPart") 
        or model:FindFirstChild("PrimaryPart")
        or model:FindFirstChild("Handle") 
        or (model:IsA("BasePart") and model)
        or model:FindFirstChildOfClass("BasePart")

    if not targetPart then return end

    local distance = 0
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        distance = math.floor((LocalPlayer.Character.HumanoidRootPart.Position - targetPart.Position).Magnitude)
    end

    local bb = model:FindFirstChild(tagName)
    if not bb then
        bb = Instance.new("BillboardGui")
        bb.Name = tagName
        bb.Adornee = targetPart
        bb.Size = UDim2.new(0, 160, 0, 35)
        bb.StudsOffset = Vector3.new(0, 2.5, 0)
        bb.AlwaysOnTop = true
        
        local label = Instance.new("TextLabel")
        label.Name = "Text"
        label.Parent = bb
        label.BackgroundTransparency = 1
        label.Size = UDim2.new(1, 0, 1, 0)
        label.TextColor3 = color
        label.TextStrokeTransparency = 0
        label.TextSize = 13
        label.Font = Enum.Font.SourceSansBold
        bb.Parent = model
    end

    local textLabel = bb:FindFirstChild("Text")
    if textLabel then
        textLabel.Text = string.format("%s [%d studs]", displayName, distance)
    end
end

local function isMonster(obj)
    if not obj:IsA("Model") or Players:GetPlayerFromCharacter(obj) then return false end
    local nameLower = obj.Name:lower()
    if nameLower:find("monster") or nameLower:find("creature") or nameLower:find("angel") or nameLower:find("alien") or nameLower:find("death") or nameLower:find("beast") or obj:FindFirstChildOfClass("Humanoid") then
        return true
    end
    return false
end

local function getFilteredItem(obj)
    if Players:GetPlayerFromCharacter(obj) or isMonster(obj) then return false, nil end

    local nameLower = obj.Name:lower()
    local promptText = ""
    local prompt = obj:FindFirstChildOfClass("ProximityPrompt") or obj:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt then
        promptText = (prompt.ObjectText .. " " .. prompt.ActionText):lower()
    end

    local checkStr = nameLower .. " " .. promptText

    if Toggles.FoodESP and (checkStr:find("food") or checkStr:find("apple") or checkStr:find("snack") or checkStr:find("meat") or checkStr:find("water") or checkStr:find("drink") or checkStr:find("eat") or checkStr:find("bread")) then
        return true, "Food (" .. obj.Name .. ")"
    end

    if Toggles.MedicalESP and (checkStr:find("med") or checkStr:find("bandage") or checkStr:find("health")) then
        return true, "Medical"
    end

    if Toggles.WeaponESP and (checkStr:find("gun") or checkStr:find("ammo") or checkStr:find("shotgun") or checkStr:find("rifle") or checkStr:find("pistol") or checkStr:find("weapon") or obj:IsA("Tool")) then
        return true, obj.Name
    end

    if Toggles.ObjectiveESP and (checkStr:find("fuse") or checkStr:find("key") or checkStr:find("card") or checkStr:find("battery") or checkStr:find("part") or checkStr:find("gear")) then
        return true, obj.Name
    end

    if Toggles.NoiseESP and (checkStr:find("radio") or checkStr:find("flare") or checkStr:find("noise") or checkStr:find("bottle") or checkStr:find("can")) then
        return true, obj.Name
    end

    return false, nil
end

