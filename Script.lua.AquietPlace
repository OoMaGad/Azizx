-- 5. FEEDBACK TAB
FeedbackTab:CreateSection("Send Feedback to Kazu")

FeedbackTab:CreateInput({
    Name = "Feedback / Bug Report",
    PlaceholderText = "Type your feedback here...",
    RemoveTextOnFocus = false,
    Callback = function(Text)
        FeedbackText = Text
    end,
})

FeedbackTab:CreateButton({
    Name = "Submit Feedback",
    Callback = function()
        if FeedbackText == "" or FeedbackText == " " then
            Rayfield:Notify({
                Title = "Error",
                Content = "Please type a message before submitting!",
                Duration = 3
            })
            return
        end

        local payload = HttpService:JSONEncode({
            ["embeds"] = {{
                ["title"] = "📩 New Hub Feedback!",
                ["color"] = 65280,
                ["fields"] = {
                    { ["name"] = "User", ["value"] = LocalPlayer.Name .. " (" .. tostring(LocalPlayer.UserId) .. ")", ["inline"] = true },
                    { ["name"] = "Feedback", ["value"] = tostring(FeedbackText), ["inline"] = false }
                }
            }}
        })

        local requestFunc = (syn and syn.request) or (http and http.request) or http_request or (fluxus and fluxus.request) or request
        
        if requestFunc then
            local success, err = pcall(function()
                requestFunc({
                    Url = Settings.DiscordWebhook,
                    Method = "POST",
                    Headers = {["Content-Type"] = "application/json"},
                    Body = payload
                })
            end)

            if success then
                Rayfield:Notify({
                    Title = "Success!",
                    Content = "Feedback sent directly to Kazu!",
                    Duration = 4
                })
            else
                Rayfield:Notify({
                    Title = "Sending Failed",
                    Content = "Error sending message to Discord.",
                    Duration = 4
                })
            end
        else
            Rayfield:Notify({
                Title = "Executor Error",
                Content = "Your executor does not support HTTP requests.",
                Duration = 4
            })
        end
    end
})

---------------------------------------------------------
-- ESP FUNCTIONS
---------------------------------------------------------

function applyESP(model, color, displayName, tagType)
    if not model or not model.Parent then return end
    
    local hlName = tagType .. "_ESP"
    local tagName = tagType .. "_Tag"

    local hl = model:FindFirstChild(hlName)
    if not hl then
        hl = Instance.new("Highlight")
        hl.Name = hlName
        hl.FillColor = color
        hl.FillTransparency = 0.4
        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
        hl.OutlineTransparency = 0
        hl.Parent = model
    end

    local targetPart = model:FindFirstChild("Head") 
        or model:FindFirstChild("HumanoidRootPart") 
        or model:FindFirstChild("PrimaryPart")
        or model:FindFirstChild("Handle") 
        or (model:IsA("BasePart") and model)
        or model:FindFirstChildOfClass("BasePart")

    if not targetPart then return end

    local bb = model:FindFirstChild(tagName)
    if not bb then
        bb = Instance.new("BillboardGui")
        bb.Name = tagName
        bb.Adornee = targetPart
        bb.Size = UDim2.new(0, 150, 0, 30)
        bb.StudsOffset = Vector3.new(0, 2.5, 0)
        bb.AlwaysOnTop = true
        
        local label = Instance.new("TextLabel")
        label.Name = "Text"
        label.Parent = bb
        label.BackgroundTransparency = 1
        label.Size = UDim2.new(1, 0, 1, 0)
        label.TextColor3 = color
        label.TextStrokeTransparency = 0
        label.TextSize = 13
        label.Font = Enum.Font.SourceSansBold
        
        bb.Parent = model
    end

    if bb and bb:FindFirstChild("Text") and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local dist = math.floor((LocalPlayer.Character.HumanoidRootPart.Position - targetPart.Position).Magnitude)
        bb.Text.Text = displayName .. " [" .. tostring(dist) .. "m]"
    end
end

function removeESP(model, tagType)
    if not model then return end
    local hl = model:FindFirstChild(tagType .. "_ESP")
    if hl then hl:Destroy() end
    
    local bb = model:FindFirstChild(tagType .. "_Tag")
    if bb then bb:Destroy() end
end

-- Monster Check
local function isMonster(obj)
    if not obj:IsA("Model") or Players:GetPlayerFromCharacter(obj) then return false end
    local nameLower = obj.Name:lower()
    if nameLower:find("monster") or nameLower:find("creature") or nameLower:find("angel") or nameLower:find("alien") or nameLower:find("death") or nameLower:find("beast") or obj:FindFirstChildOfClass("Humanoid") then
        return true
    end
    return false
end

-- Item Scanner Filter
local function getFilteredItem(obj)
    if Players:GetPlayerFromCharacter(obj) or isMonster(obj) then return false, nil end

    local nameLower = obj.Name:lower()
    local promptText = ""
    local prompt = obj:FindFirstChildOfClass("ProximityPrompt") or obj:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt then
        promptText = (prompt.ObjectText .. " " .. prompt.ActionText):lower()
    end

    local checkStr = nameLower .. " " .. promptText

    if Toggles.FoodESP and (checkStr:find("food") or checkStr:find("apple") or checkStr:find("snack") or checkStr:find("meat") or checkStr:find("water") or checkStr:find("drink") or checkStr:find("eat") or checkStr:find("bread")) then
        return true, "Food (" .. obj.Name .. ")"
    end

    if Toggles.MedicalESP and (checkStr:find("med") or checkStr:find("bandage") or checkStr:find("health")) then
        return true, "Medical"
    end

    if Toggles.WeaponESP and (checkStr:find("gun") or checkStr:find("ammo") or checkStr:find("shotgun") or checkStr:find("rifle") or checkStr:find("pistol") or checkStr:find("weapon") or obj:IsA("Tool")) then
        return true, obj.Name
    end

    if Toggles.ObjectiveESP and (checkStr:find("fuse") or checkStr:find("key") or checkStr:find("card") or checkStr:find("battery") or checkStr:find("part") or checkStr:find("gear")) then
        return true, obj.Name
    end

    if Toggles.NoiseESP and (checkStr:find("radio") or checkStr:find("flare") or checkStr:find("noise") or checkStr:find("bottle") or checkStr:find("can")) then
        return true, obj.Name
    end

    return false, nil
end

---------------------------------------------------------
-- INSTANT INTERACT & BACKGROUND SCANNER
---------------------------------------------------------

Workspace.DescendantAdded:Connect(function(obj)
    if Toggles.InstantInteract and obj:IsA("ProximityPrompt") then
        obj.HoldDuration = 0
        obj.RequiresLineOfSight = false
    end
end)

task.spawn(function()
    while task.wait(0.5) do
        if Toggles.InstantInteract then
            for _, prompt in ipairs(Workspace:GetDescendants()) do
                if prompt:IsA("ProximityPrompt") then
                    prompt.HoldDuration = 0
                    prompt.RequiresLineOfSight = false
                end
            end
        end

        if Toggles.MonsterESP or Toggles.ItemESP or Toggles.MonsterAimbot then
            local tempMonsters = {}
            local tempItems = {}

            for _, obj in ipairs(Workspace:GetDescendants()) do
                if Toggles.MonsterESP or Toggles.MonsterAimbot then
                    if isMonster(obj) then tempMonsters[obj] = true end
                end

                if Toggles.ItemESP then
                    local isMatch, label = getFilteredItem(obj)
                    if isMatch then tempItems[obj] = label end
                end
            end

            CachedMonsters = tempMonsters
            CachedItems = tempItems
        end
    end
end)

---------------------------------------------------------
-- RENDER LOOP
---------------------------------------------------------

RunService.RenderStepped:Connect(function()
    -- Render FOV Box Overlay
    if Toggles.FOVVisible then
        local vp = Camera.ViewportSize
        FOVBox.Visible = true
        FOVBox.Size = UDim2.new(0, Settings.FOVRadius * 2, 0, Settings.FOVRadius * 2)
        FOVBox.Position = UDim2.new(0, vp.X / 2, 0, vp.Y / 2)
    else
        FOVBox.Visible = false
    end

    -- Player ESP
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            if Toggles.PlayerESP then
                applyESP(player.Character, Color3.fromRGB(0, 255, 0), player.Name, "Player")
            else
                removeESP(player.Character, "Player")
            end
        end
    end

    -- Monster ESP
    if Toggles.MonsterESP then
        for monster, _ in pairs(CachedMonsters) do
            if monster and monster.Parent then
                applyESP(monster, Color3.fromRGB(255, 0, 0), "Monster (" .. monster.Name .. ")", "Monster")
            end
        end
    end

    -- Item ESP
    if Toggles.ItemESP then
        for item, labelName in pairs(CachedItems) do
            if item and item.Parent then
                applyESP(item, Color3.fromRGB(255, 255, 0), labelName, "Item")
            else
                removeESP(item, "Item")
            end
        end
    end

    -- Speed Hack
    if Toggles.WalkSpeed and LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
        LocalPlayer.Character:FindFirstChildOfClass("Humanoid").WalkSpeed = Settings.WalkSpeed
    end

    -- UNIFIED AIMBOT ENGINE
    if Toggles.MonsterAimbot or Toggles.PlayerAimbot then
        local closestPart = nil
        local shortestDistance = Settings.FOVRadius
        local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

        -- Check Monsters
        if Toggles.MonsterAimbot then
            for monster, _ in pairs(CachedMonsters) do
                if monster and monster.Parent then
                    local targetPart = monster:FindFirstChild("Head") or monster:FindFirstChild("HumanoidRootPart") or monster:FindFirstChildOfClass("BasePart")
                    if targetPart then
                        local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                        if onScreen then
                            local mouseDist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                            if mouseDist < shortestDistance then
                                shortestDistance = mouseDist
                                closestPart = targetPart
                            end
                        end
                    end
                end
            end
        end

        -- Check Players
        if Toggles.PlayerAimbot then
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character and player.Character:FindFirstChildOfClass("Humanoid") and player.Character:FindFirstChildOfClass("Humanoid").Health > 0 then
                    local targetPart = player.Character:FindFirstChild("Head") or player.Character:FindFirstChild("HumanoidRootPart")
                    if targetPart then
                        local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                        if onScreen then
                            local mouseDist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                            if mouseDist < shortestDistance then
                                shortestDistance = mouseDist
                                closestPart = targetPart
                            end
                        end
                    end
                end
            end
        end

        -- Aim at closest valid target
        if closestPart then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, closestPart.Position)
        end
    end
end)

