ConfigGroup:AddInput("ConfigName", { Text = "Config name", Default = "", Placeholder = "Enter config name..." })

ConfigGroup:AddButton({
    Text = "Craft configuration",
    Func = function()
        local name = Options.ConfigName.Value
        if not name or name == "" then
            Library:Notify("Please enter a config name!", 4)
            return
        end
        
        local data = { Toggles = {}, Options = {} }
        for idx, toggle in pairs(Toggles) do data.Toggles[idx] = toggle.Value end
        for idx, option in pairs(Options) do
            if idx ~= "ConfigName" and idx ~= "ConfigList" and idx ~= "FeedbackInput" then
                data.Options[idx] = option.Value
            end
        end
        
        if not _isfolder("KazuHub_Configs") then _makefolder("KazuHub_Configs") end
        _writefile("KazuHub_Configs/" .. name .. ".json", HttpService:JSONEncode(data))
        Library:Notify("Config '" .. name .. "' created!", 4)
    end,
})

---------------------------------------------------------
-- ESP CORE & LAG-REDUCED CACHING SYSTEM
---------------------------------------------------------
local CachedMonsters = {}
local CachedItems = {}

local function removeESP(model, tagType)
    if not model then return end
    local hl = model:FindFirstChild(tagType .. "_ESP")
    if hl then hl:Destroy() end
    local bb = model:FindFirstChild(tagType .. "_Tag")
    if bb then bb:Destroy() end
end

local function applyESP(model, color, displayName, tagType)
    if not model or not model.Parent then return end
    
    local hlName = tagType .. "_ESP"
    local tagName = tagType .. "_Tag"

    local targetPart = model:FindFirstChild("Head") 
        or model:FindFirstChild("HumanoidRootPart") 
        or model:FindFirstChild("PrimaryPart")
        or model:FindFirstChild("Handle") 
        or (model:IsA("BasePart") and model)
        or model:FindFirstChildOfClass("BasePart")

    if not targetPart then return end

    local distance = 0
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        distance = math.floor((LocalPlayer.Character.HumanoidRootPart.Position - targetPart.Position).Magnitude)
    end

    local maxDist = Options.MaxDist and Options.MaxDist.Value or 500
    if distance > maxDist then
        removeESP(model, tagType)
        return
    end

    local hl = model:FindFirstChild(hlName)
    if not hl then
        hl = Instance.new("Highlight")
        hl.Name = hlName
        hl.FillColor = color
        hl.FillTransparency = 0.4
        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
        hl.OutlineTransparency = 0
        hl.Parent = model
    end

    local bb = model:FindFirstChild(tagName)
    if not bb then
        bb = Instance.new("BillboardGui")
        bb.Name = tagName
        bb.Adornee = targetPart
        bb.Size = UDim2.new(0, 160, 0, 35)
        bb.StudsOffset = Vector3.new(0, 2.5, 0)
        bb.AlwaysOnTop = true
        
        local label = Instance.new("TextLabel")
        label.Name = "Text"
        label.Parent = bb
        label.BackgroundTransparency = 1
        label.Size = UDim2.new(1, 0, 1, 0)
        label.TextColor3 = color
        label.TextStrokeTransparency = 0
        label.TextSize = 13
        label.Font = Enum.Font.SourceSansBold
        bb.Parent = model
    end

    local textLabel = bb:FindFirstChild("Text")
    if textLabel then
        textLabel.Text = string.format("%s [%d studs]", displayName, distance)
    end
end

local function isMonster(obj)
    if not obj:IsA("Model") or Players:GetPlayerFromCharacter(obj) then return false end
    if obj:FindFirstChildOfClass("Humanoid") then return true end
    local nameLower = obj.Name:lower()
    if nameLower:find("monster") or nameLower:find("creature") or nameLower:find("angel") or nameLower:find("alien") or nameLower:find("death") or nameLower:find("beast") then
        return true
    end
    return false
end

local function getFilteredItem(obj)
    if Players:GetPlayerFromCharacter(obj) or isMonster(obj) then return false, nil end
    if obj:FindFirstChildOfClass("Humanoid") or obj:IsA("Humanoid") then return false, nil end
    
    if not Toggles or not Toggles.ItemESP or not Toggles.ItemESP.Value then return false, nil end

    local nameLower = obj.Name:lower()

    if nameLower:find("door") or nameLower:find("opener") or nameLower:find("leaf") or nameLower:find("leaves") 
        or nameLower:find("trunk") or nameLower:find("tree") or nameLower:find("branch") or nameLower:find("meshpart") 
        or nameLower:find("terrain") or nameLower:find("rock") or nameLower:find("stone") or nameLower:find("bush") 
        or nameLower:find("grass") or nameLower:find("flower") or nameLower:find("wood") or nameLower:find("prop") then
        return false, nil
    end

    local prompt = obj:FindFirstChildOfClass("ProximityPrompt") or obj:FindFirstChildWhichIsA("ProximityPrompt", true)
    if not prompt and not obj:IsA("Tool") then 
        return false, nil 
    end

    local promptText = ""
    if prompt then 
        promptText = prompt.ObjectText ~= "" and prompt.ObjectText or prompt.ActionText 
    end

    local combinedCheck = (nameLower .. " " .. promptText):lower()
    if combinedCheck:find("door") or combinedCheck:find("opener") then
        return false, nil
    end

    local cleanName = promptText ~= "" and promptText or obj.Name

    if combinedCheck:find("battery") or combinedCheck:find("cell") or combinedCheck:find("flare") or combinedCheck:find("flashlight") or combinedCheck:find("oxygen") or combinedCheck:find("gas") or combinedCheck:find("fuel") or combinedCheck:find("fuse") or combinedCheck:find("key") or combinedCheck:find("card") then
        return true, cleanName
    end

    if Toggles.FoodESP.Value and (combinedCheck:find("food") or combinedCheck:find("apple") or combinedCheck:find("snack") or combinedCheck:find("meat") or combinedCheck:find("water")) then return true, cleanName end
    if Toggles.MedicalESP.Value and (combinedCheck:find("med") or combinedCheck:find("bandage") or combinedCheck:find("health") or combinedCheck:find("kit")) then return true, cleanName end
    if Toggles.WeaponESP.Value and (combinedCheck:find("gun") or combinedCheck:find("rifle") or combinedCheck:find("sniper") or combinedCheck:find("ammo") or combinedCheck:find("pistol") or obj:IsA("Tool")) then return true, cleanName end
    if Toggles.ObjectiveESP.Value and (combinedCheck:find("part") or combinedCheck:find("gear") or combinedCheck:find("valve") or combinedCheck:find("code")) then return true, cleanName end
    if Toggles.NoiseESP.Value and (combinedCheck:find("radio") or combinedCheck:find("noise") or combinedCheck:find("bottle") or combinedCheck:find("alarm")) then return true, cleanName end

    if prompt then
        return true, cleanName
    end

    return false, nil
end

---------------------------------------------------------
-- OPTIMIZED BACKGROUND LOOPS (LAG REDUCTION)
---------------------------------------------------------
Workspace.DescendantAdded:Connect(function(obj)
    if Toggles and Toggles.InstantInteract and Toggles.InstantInteract.Value and obj:IsA("ProximityPrompt") then
        obj.HoldDuration = 0
        obj.RequiresLineOfSight = false
    end
end)

task.spawn(function()
    while task.wait(1.2) do
        if Toggles and Toggles.InstantInteract and Toggles.InstantInteract.Value then
            for _, prompt in ipairs(Workspace:GetDescendants()) do
                if prompt:IsA("ProximityPrompt") then
                    prompt.HoldDuration = 0
                    prompt.RequiresLineOfSight = false
                end
            end
        end

        local tempMonsters, tempItems = {}, {}
        if Toggles and (Toggles.MonsterESP.Value or Toggles.ItemESP.Value or Toggles.MonsterAimbot.Value) then
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if Toggles.MonsterESP.Value or Toggles.MonsterAimbot.Value then
                    if isMonster(obj) then tempMonsters[obj] = true end
                end
                if Toggles.ItemESP.Value then
                    local isMatch, label = getFilteredItem(obj)
                    if isMatch then tempItems[obj] = label end
                end
            end
        end
        CachedMonsters = tempMonsters
        CachedItems = tempItems
    end
end)

RunService.RenderStepped:Connect(function()
    if not Toggles or not Toggles.PlayerESP then return end

    if Toggles.PlayerESP.Value then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                applyESP(player.Character, Color3.fromRGB(0, 255, 0), player.Name, "Player")
            end
        end
    else
        for _, player in ipairs(Players:GetPlayers()) do
            if player.Character then removeESP(player.Character, "Player") end
        end
    end

    if Toggles.MonsterESP.Value then
        for monster, _ in pairs(CachedMonsters) do applyESP(monster, Color3.fromRGB(255, 0, 0), "Monster", "Monster") end
    end

    if Toggles.ItemESP.Value then
        for item, labelName in pairs(CachedItems) do applyESP(item, Color3.fromRGB(255, 255, 0), labelName, "Item") end
    end

    if Toggles.WalkSpeedToggle and Toggles.WalkSpeedToggle.Value and LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum.WalkSpeed = Options.WalkSpeedVal.Value end
    end

    if Toggles.JumpToggle and Toggles.JumpToggle.Value and LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then 
            hum.UseJumpPower = true
            hum.JumpPower = Options.JumpVal.Value 
        end
    end

    if Toggles.MonsterAimbot.Value or Tlogoes and Toggles.PlayerAimbot.Value then
        local closestPart = nil
        local fov = Options.FOVSize.Value or 200
        local shortestDistance = fov
        local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

        local targets = {}
        if Toggles.MonsterAimbot.Value then for m,_ in pairs(CachedMonsters) do table.insert(targets, m) end end
        if Toggles.PlayerAimbot.Value then 
            for _,p in ipairs(Players:GetPlayers()) do 
                if p ~= LocalPlayer and p.Character then table.insert(targets, p.Character) end 
            end 
        end

        for _, target in ipairs(targets) do
            local targetPart = target:FindFirstChild("Head") or target:FindFirstChild("HumanoidRootPart")
            if targetPart then
                local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                if onScreen then
                    local mouseDist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                    if mouseDist < shortestDistance then
                        shortestDistance = mouseDist
                        closestPart = targetPart
                    end
                end
            end
        end

        if closestPart then Camera.CFrame = CFrame.new(Camera.CFrame.Position, closestPart.Position) end
    end
end)

Library:Notify("Delta Mobile interface loaded!", 5)

