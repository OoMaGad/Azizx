--[[
    Title: ZanN Hub v10.7 (Anti-Anticheat Bypass Edition)
    Updates: Added Instant Interact feature, filtered out freezers/gas stations, and added grenade to weapons.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local CoreGui = game:GetService("CoreGui")
local Camera = Workspace.CurrentCamera
local LocalPlayer = Players.LocalPlayer

if CoreGui:FindFirstChild("ZanNHub") then
    CoreGui.ZanNHub:Destroy()
end

local Config = {
    PlayerESP = false,
    MonsterESP = false,
    ItemESP = false,
    InstantInteract = false,
    Aimbot = false,
    CharacterGlow = false,
    SpeedHack = false,
    WalkSpeed = 50,
    JumpHack = false,
    JumpPower = 150,
    Filters = { Weapon = true, Ammo = true, Medical = true, Food = true, Battery = true, Other = true }
}

