local toggleButtons = {}

local function createToggle(name, configKey, isFilter)
    local default = isFilter and Config.Filters[configKey] or Config[configKey]
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 28)
    btn.BackgroundColor3 = default and Color3.fromRGB(180, 60, 110) or Color3.fromRGB(45, 25, 36)
    btn.BorderSizePixel = 0
    btn.Font = Enum.Font.GothamBold
    btn.Text = name .. ": " .. (default and "ON" or "OFF")
    btn.TextColor3 = Color3.fromRGB(255, 220, 235)
    btn.TextSize = 11
    btn.Parent = ScrollContainer
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 5)
    corner.Parent = btn
    
    local function updateState(newState)
        if isFilter then
            Config.Filters[configKey] = newState
        else
            Config[configKey] = newState
        end
        btn.BackgroundColor3 = newState and Color3.fromRGB(180, 60, 110) or Color3.fromRGB(45, 25, 36)
        btn.Text = name .. ": " .. (newState and "ON" or "OFF")
    end

    btn.MouseButton1Click:Connect(function()
        local currentVal = isFilter and Config.Filters[configKey] or Config[configKey]
        updateState(not currentVal)
    end)

    toggleButtons[configKey] = {button = btn, update = updateState}
end

createToggle("Player ESP", "PlayerESP", false)
createToggle("Monster ESP", "MonsterESP", false)
createToggle("Items esp", "ItemESP", false)
createToggle("Instant Interact", "InstantInteract", false)
createToggle("Aimbot [E]", "Aimbot", false)
createToggle("Character Glow", "CharacterGlow", false)
createToggle("Speed Hack", "SpeedHack", false)
createToggle("Jump Hack", "JumpHack", false)
createToggle("Filter: Weapon", "Weapon", true)
createToggle("Filter: Ammo", "Ammo", true)
createToggle("Filter: Medical", "Medical", true)
createToggle("Filter: Food", "Food", true)
createToggle("Filter: Battery", "Battery", true)
createToggle("Filter: Other", "Other", true)

-- Mobile Toggle Floating Button
local MobileToggleBtn = Instance.new("ImageButton")
MobileToggleBtn.Name = "MobileToggleButton"
MobileToggleBtn.Parent = ScreenGui
MobileToggleBtn.BackgroundColor3 = Color3.fromRGB(45, 25, 36)
MobileToggleBtn.Position = UDim2.new(0, 20, 0.4, 0)
MobileToggleBtn.Size = UDim2.new(0, 50, 0, 50)
MobileToggleBtn.Image = "rbxassetid://76007855155881"

local MobileCorner = Instance.new("UICorner")
MobileCorner.CornerRadius = UDim.new(1, 0)
MobileCorner.Parent = MobileToggleBtn

MobileToggleBtn.MouseButton1Click:Connect(function()
    MainFrame.Visible = not MainFrame.Visible
end)

-- Make Mobile Toggle Button Draggable
local mDragging, mDragStart, mStartPos
MobileToggleBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        mDragging = true
        mDragStart = input.Position
        mStartPos = MobileToggleBtn.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then mDragging = false end
        end)
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) and mDragging then
        local delta = input.Position - mDragStart
        MobileToggleBtn.Position = UDim2.new(mStartPos.X.Scale, mStartPos.X.Offset + delta.X, mStartPos.Y.Scale, mStartPos.Y.Offset + delta.Y)
    end
end)

-- Keyboard Controls
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if input.KeyCode == Enum.KeyCode.RightShift then
        MainFrame.Visible = not MainFrame.Visible
    elseif input.KeyCode == Enum.KeyCode.E and not gameProcessed then
        local aimToggle = toggleButtons["Aimbot"]
        if aimToggle then
            aimToggle.update(not Config.Aimbot)
        end
    end
end)

-- Dragging logic for Main Window
local dragging, dragInput, dragStart, startPos
MainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)
MainFrame.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

-- Drawing Pool Setup
local ESPCache = {}
local function getDrawing(target)
    if not ESPCache[target] then
        local txt = Drawing.new("Text")
        txt.Visible = false
        txt.Center = true
        txt.Outline = true
        txt.OutlineColor = Color3.fromRGB(0, 0, 0)
        txt.Font = 1
        txt.Size = 11
        ESPCache[target] = txt
    end
    return ESPCache[target]
end

local function getItemCategory(name)
    name = string.lower(name)
    if string.find(name, "battery") or string.find(name, "cell") or string.find(name, "power") then
        return "Battery"
    elseif string.find(name, "flare gun") or string.find(name, "gun") or string.find(name, "rifle") or string.find(name, "pistol") or string.find(name, "shotgun") or string.find(name, "smg") or string.find(name, "knife") or string.find(name, "sword") or string.find(name, "bat") or string.find(name, "melee") or string.find(name, "weapon") or string.find(name, "revolver") or string.find(name, "sniper") or string.find(name, "axe") or string.find(name, "machete") or string.find(name, "crowbar") or string.find(name, "pipe") or string.find(name, "hammer") or string.find(name, "club") or string.find(name, "grenade") then 
        return "Weapon"
    elseif string.find(name, "flare pack") or string.find(name, "ammo") or string.find(name, "bullet") or string.find(name, "mag") or string.find(name, "round") or string.find(name, "shell") or string.find(name, "box") or string.find(name, "pack") then 
        return "Ammo"
    elseif string.find(name, "med") or string.find(name, "bandage") or string.find(name, "heal") or string.find(name, "kit") or string.find(name, "pill") or string.find(name, "first") or string.find(name, "syringe") or string.find(name, "health") or string.find(name, "pain") or string.find(name, "tonic") or string.find(name, "gauze") then 
        return "Medical"
    elseif string.find(name, "food") or string.find(name, "water") or string.find(name, "can") or string.find(name, "drink") or string.find(name, "apple") or string.find(name, "bottle") or string.find(name, "mre") or string.find(name, "soup") or string.find(name, "cola") then 
        return "Food"
    else 
        return "Other" 
    end
end

local function isValidItemName(name)
    local low = string.lower(name)
    if string.find(low, "door") or string.find(low, "opener") or string.find(low, "gate") or string.find(low, "lever") or string.find(low, "switch") or string.find(low, "button") or string.find(low, "drawer") or string.find(low, "chest") or string.find(low, "desk") or string.find(low, "house") or string.find(low, "home") or string.find(low, "building") or string.find(low, "cabinet") or string.find(low, "cabin") or string.find(low, "shack") or string.find(low, "freezer") or string.find(low, "gasstation") then
        return false
    end
    return true
end

local scanTimer = 0
local cachedEntities = {}
local cachedItems = {}

-- Anti-Cheat Bypass Variables
local isJumpingOrFalling = false

-- Complete Fall Damage Hook/Bypass
local function hookFallDamage()
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.StateChanged:Connect(function(_, newState)
            if newState == Enum.HumanoidStateType.FallingDown or newState == Enum.HumanoidStateType.Ragdoll then
                hum:ChangeState(Enum.HumanoidStateType.GettingUp)
            end
        end)
    end
end

LocalPlayer.CharacterAdded:Connect(function(char)
    char:WaitForChild("Humanoid")
    hookFallDamage()
end)
hookFallDamage()

Workspace.DescendantAdded:Connect(function(obj)
    if obj:IsA("ProximityPrompt") and Config.InstantInteract then
        obj.HoldDuration = 0
    end
end)

RunService.RenderStepped:Connect(function(dt)
    scanTimer = scanTimer + dt
    if scanTimer >= 1.0 then
        scanTimer = 0
        cachedEntities = {}
        cachedItems = {}
        
        -- Deep Monster & Player Search
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("Model") then
                local hum = obj:FindFirstChildOfClass("Humanoid")
                if hum then
                    local p = Players:GetPlayerFromCharacter(obj)
                    if p and p ~= LocalPlayer then
                        table.insert(cachedEntities, {type = "Player", model = obj, name = p.Name})
                    elseif not p then
                        local nLow = string.lower(obj.Name)
                        if nLow ~= "camera" and not string.find(nLow, "item") then
                            table.insert(cachedEntities, {type = "Monster", model = obj, name = obj.Name})
                        end
                    end
                end
            end
        end

        -- Accurate Item Search & Instant Interact Application
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("ProximityPrompt") then
                if Config.InstantInteract then
                    obj.HoldDuration = 0
                end
                
                local itemParent = obj.Parent
                while itemParent and itemParent ~= Workspace do
                    if itemParent:IsA("Model") then
                        local realName = itemParent.Name
                        if isValidItemName(realName) then
                            local primary = itemParent.PrimaryPart or itemParent:FindFirstChildWhichIsA("BasePart")
                            if primary and realName ~= "Workspace" then
                                table.insert(cachedItems, {part = primary, name = realName, cat = getItemCategory(realName)})
                                break
                            end
                        end
                    end
                    itemParent = itemParent.Parent
                end
            end
        end
    end

    local closestTarget = nil
    local shortestDist = math.huge
    local activeDrawings = {}

    -- Handle Speed Hack, Safe Movement Interpolation, and Jump Hack
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hum and hrp then
            if Config.SpeedHack then
                hum.WalkSpeed = Config.WalkSpeed
                
                local moveDir = hum.MoveDirection
                if moveDir.Magnitude > 0 then
                    local currentVel = hrp.AssemblyLinearVelocity
                    hrp.AssemblyLinearVelocity = Vector3.new(moveDir.X * Config.WalkSpeed, currentVel.Y, moveDir.Z * Config.WalkSpeed)
                end
            end
            
            if Config.JumpHack then
                hum.UseJumpPower = true
                hum.JumpPower = Config.JumpPower

                if hum:GetState() == Enum.HumanoidStateType.Jumping or hum:GetState() == Enum.HumanoidStateType.Freefall then
                    isJumpingOrFalling = true
                elseif isJumpingOrFalling then
                    if hum.FloorMaterial ~= Enum.Material.Air then
                        isJumpingOrFalling = false
                    else
                        local vel = hrp.AssemblyLinearVelocity
                        if vel.Y < -100 then
                            hrp.AssemblyLinearVelocity = Vector3.new(vel.X, -50, vel.Z)
                        end
                    end
                end
            end
        end
    end

    -- Render Players & Monsters
    for _, entity in ipairs(cachedEntities) do
        local model = entity.model
        local hrp = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChildWhichIsA("BasePart")
        local hum = model:FindFirstChildOfClass("Humanoid")
        
        if hrp and hum and hum.Health > 0 then
            local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
            if onScreen then
                local dist = (Camera.CFrame.Position - hrp.Position).Magnitude
                local showPlr = (entity.type == "Player" and Config.PlayerESP)
                local showMon = (entity.type == "Monster" and Config.MonsterESP)

                if showPlr or showMon then
                    local txt = getDrawing(model)
                    activeDrawings[model] = true
                    txt.Visible = true
                    txt.Position = Vector2.new(pos.X, pos.Y)
                    
                    if entity.type == "Player" then
                        txt.Text = string.format("[Player] %s [%dm]", entity.name, math.floor(dist))
                        txt.Color = Color3.fromRGB(80, 200, 255)
                    else
                        txt.Text = string.format("[Monster] %s [%dm]", entity.name, math.floor(dist))
                        txt.Color = Color3.fromRGB(255, 50, 50)
                    end

                    if Config.Aimbot and entity.type == "Monster" then
                        local centerScreen = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
                        local d2Center = (Vector2.new(pos.X, pos.Y) - centerScreen).Magnitude
                        if d2Center < shortestDist then
                            shortestDist = d2Center
                            closestTarget = hrp
                        end
                    end
                end
            end
        end
    end

    -- Render Items ESP
    if Config.ItemESP then
        for _, item in ipairs(cachedItems) do
            if Config.Filters[item.cat] then
                local pos, onScreen = Camera:WorldToViewportPoint(item.part.Position)
                if onScreen then
                    local dist = (Camera.CFrame.Position - item.part.Position).Magnitude
                    local txt = getDrawing(item.part)
                    activeDrawings[item.part] = true
                    txt.Visible = true
                    txt.Position = Vector2.new(pos.X, pos.Y)
                    txt.Text = string.format("[%s] %s [%dm]", item.cat, item.name, math.floor(dist))
                    txt.Color = Color3.fromRGB(50, 255, 50)
                end
            end
        end
    end

    -- Character Glow
    if Config.CharacterGlow then
        for _, entity in ipairs(cachedEntities) do
            local model = entity.model
            local isMon = (entity.type == "Monster")
            local glowColor = isMon and Color3.fromRGB(255, 0, 0) or Color3.fromRGB(0, 150, 255)
            local effectName = isMon and "RedGlowEffect" or "BlueGlowEffect"
            local oppositeName = isMon and "BlueGlowEffect" or "RedGlowEffect"

            for _, part in ipairs(model:GetDescendants()) do
                if part:IsA("BasePart") then
                    local oldHl = part:FindFirstChild(oppositeName)
                    if oldHl then oldHl:Destroy() end

                    local hl = part:FindFirstChild(effectName)
                    if not hl then
                        hl = Instance.new("Highlight")
                        hl.Name = effectName
                        hl.Adornee = model
                        hl.FillColor = glowColor
                        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                        hl.FillTransparency = 0.4
                        hl.Parent = part
                    end
                end
            end
        end
    else
        for _, entity in ipairs(cachedEntities) do
            local model = entity.model
            for _, part in ipairs(model:GetDescendants()) do
                if part:IsA("BasePart") then
                    local hl1 = part:FindFirstChild("RedGlowEffect")
                    local hl2 = part:FindFirstChild("BlueGlowEffect")
                    if hl1 then hl1:Destroy() end
                    if hl2 then hl2:Destroy() end
                end
            end
        end
    end

    -- Cleanup hidden text instances
    for obj, txt in pairs(ESPCache) do
        if not activeDrawings[obj] then
            txt.Visible = false
        end
    end

    -- Aimbot Execution
    if Config.Aimbot and closestTarget then
        Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, closestTarget.Position), 0.3)
    end
end)

