-- 4. FEEDBACK TAB
local FeedbackGroup = FeedbackTab:AddLeftGroupbox("Send Feedback to Kazu", "send")
FeedbackGroup:AddInput("FeedbackInput", {
    Default = "",
    Numeric = false,
    Finished = false,
    Text = "Feedback / Bug Report",
    Placeholder = "Type feedback here...",
    Callback = function(Text) FeedbackText = Text end
})
FeedbackGroup:AddButton("Submit Feedback", function()
    if FeedbackText == "" then return end
    local payload = HttpService:JSONEncode({["embeds"]={{["title"]="New Feedback",["fields"]={{["name"]="User",["value"]=LocalPlayer.Name},{["name"]="Text",["value"]=FeedbackText}}}}})
    local req = syn.request or http.request or http_request or request
    if req then pcall(function() req({Url = Settings.DiscordWebhook, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = payload}) end) end
    Library:Notify("Feedback sent successfully!", 5)
end)

