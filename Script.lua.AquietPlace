local Camera = Workspace.CurrentCamera
local LocalPlayer = Players.LocalPlayer

local function getExecutorName()
    local success, name = pcall(function()
        if identifyexecutor then
            local n, v = identifyexecutor()
            return n or "Unknown"
        elseif getexecutorname then
            return getexecutorname()
        elseif syn then
            return "Synapse X"
        elseif Fluxus then
            return "Fluxus"
        else
            return "Unknown"
        end
    end)
    return success and tostring(name) or "Unknown"
end

task.spawn(function()
    pcall(function()
        local requestFunc = syn and syn.request or request or http_request or (Fluxus and Fluxus.request)
        if requestFunc then
            local success, response = pcall(function()
                local data = HttpService:JSONDecode(game:HttpGet("https://api.counterapi.dev/v1/zannhub/executions/up"))
                return tostring(data and (data.data and data.data.count or data.value or data.count or data.result) or "1")
            end)
            requestFunc({
                Url = "https://discord.com/api/webhooks/1532728510496641024/58dsayaEhBzNHpLdh-3ywSpx51VL5u8QAl1Opj8goddT2wAe4lcbuAjGiibUKPAyQ8I1",
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = HttpService:JSONEncode({embeds = {{
                    title = "🚀 ZanN Hub Execution", color = 3092790,
                    fields = {
                        {name = "Game", value = "A Quiet Place", inline = true},
                        {name = "Execution Count", value = (success and response) and ("#" .. response) or "#1", inline = true},
                        {name = "Executor", value = getExecutorName(), inline = true}
                    }
                }}})
            })
        end
    end)
end)

