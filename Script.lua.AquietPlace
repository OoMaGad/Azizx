-- Services
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer
local Camera = Workspace.CurrentCamera

-- Load Rayfield UI
local Rayfield = loadstring(game:HttpGet("https://sirius.menu/rayfield"))()

local Window = Rayfield:CreateWindow({
    Name = "Universal Utility Hub",
    LoadingTitle = "Loading System...",
    ConfigurationSaving = { Enabled = false },
    KeySystem = false
})

-- State Variables
local Toggles = {
    PlayerESP = false,
    MonsterESP = false,
    ItemESP = false,
    WeaponESP = false,
    Aimbot = false,
    FOVVisible = false,
    WalkSpeed = false,
    JumpPower = false
}

local Settings = {
    FOVRadius = 150,
    AimbotKey = Enum.UserInputType.MouseButton2,
    WalkSpeed = 50,
    JumpPower = 100,
    ItemFolder = "Items"
}

-- Rayfield UI Setup
local MainTab = Window:CreateTab("Main", 4483362458)

MainTab:CreateToggle({
    Name = "Player ESP",
    CurrentValue = false,
    Callback = function(Value) Toggles.PlayerESP = Value end
})

MainTab:CreateToggle({
    Name = "Monster ESP",
    CurrentValue = false,
    Callback = function(Value) Toggles.MonsterESP = Value end
})

MainTab:CreateToggle({
    Name = "Item ESP",
    CurrentValue = false,
    Callback = function(Value) Toggles.ItemESP = Value end
})

MainTab:CreateToggle({
    Name = "Weapon ESP",
    CurrentValue = false,
    Callback = function(Value) Toggles.WeaponESP = Value end
})

MainTab:CreateToggle({
    Name = "Aimbot",
    CurrentValue = false,
    Callback = function(Value) Toggles.Aimbot = Value end
})

MainTab:CreateToggle({
    Name = "Show FOV Circle",
    CurrentValue = false,
    Callback = function(Value) Toggles.FOVVisible = Value end
})

MainTab:CreateSlider({
    Name = "FOV Radius",
    Range = {50, 500},
    Increment = 10,
    CurrentValue = 150,
    Callback = function(Value) Settings.FOVRadius = Value end
})

MainTab:CreateToggle({
    Name = "Enable WalkSpeed",
    CurrentValue = false,
    Callback = function(Value) Toggles.WalkSpeed = Value end
})

MainTab:CreateSlider({
    Name = "WalkSpeed",
    Range = {16, 200},
    Increment = 1,
    CurrentValue = 50,
    Callback = function(Value) Settings.WalkSpeed = Value end
})

MainTab:CreateToggle({
    Name = "Enable JumpPower",
    CurrentValue = false,
    Callback = function(Value) Toggles.JumpPower = Value end
})

MainTab:CreateSlider({
    Name = "JumpPower",
    Range = {50, 300},
    Increment = 5,
    CurrentValue = 100,
    Callback = function(Value) Settings.JumpPower = Value end
})

---------------------------------------------------------
-- FUNCTIONALITY IMPLEMENTATION
---------------------------------------------------------

-- 1. FOV Circle Drawing
local FOVCircle = Drawing.new("Circle")
FOVCircle.Color = Color3.fromRGB(255, 255, 255)
FOVCircle.Thickness = 1.5
FOVCircle.NumSides = 64
FOVCircle.Filled = false
FOVCircle.Transparency = 1

-- 2. Highlight ESP Helper
local function applyHighlight(model, color, name)
    if not model or not model:IsA("Model") and not model:IsA("BasePart") then return end
    local existing = model:FindFirstChild(name .. "_ESP")
    if not existing then
        local hl = Instance.new("Highlight")
        hl.Name = name .. "_ESP"
        hl.FillColor = color
        hl.FillTransparency = 0.5
        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
        hl.OutlineTransparency = 0
        hl.Parent = model
    end
end

local function removeHighlight(model, name)
    if not model then return end
    local existing = model:FindFirstChild(name .. "_ESP")
    if existing then
        existing:Destroy()
    end
end

-- 3. Target Finder for Aimbot
local function getClosestTarget()
    local closestTarget = nil
    local shortestDistance = Settings.FOVRadius
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Head") then
            local head = player.Character.Head
            local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
            
            if onScreen then
                local mouseDist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                if mouseDist < shortestDistance then
                    shortestDistance = mouseDist
                    closestTarget = head
                end
            end
        end
    end

    return closestTarget
end

-- 4. Main Update Loop (Runs every frame)
RunService.RenderStepped:Connect(function()
    -- FOV Circle Position
    FOVCircle.Visible = Toggles.FOVVisible
    FOVCircle.Radius = Settings.FOVRadius
    FOVCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    -- Player ESP
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            if Toggles.PlayerESP then
                applyHighlight(player.Character, Color3.fromRGB(0, 255, 0), "Player")
            else
                removeHighlight(player.Character, "Player")
            end
        end
    end

    -- Monster / Item ESP Scanning in Workspace
    for _, obj in ipairs(Workspace:GetChildren()) do
        -- Monster Detection
        if obj:FindFirstChildOfClass("Humanoid") and not Players:GetPlayerFromCharacter(obj) then
            if Toggles.MonsterESP then
                applyHighlight(obj, Color3.fromRGB(255, 0, 0), "Monster")
            else
                removeHighlight(obj, "Monster")
            end
        end

        -- Item / Weapon ESP Detection
        if obj:IsA("Tool") or obj:IsA("Model") and (obj:FindFirstChild("Handle") or obj:FindFirstChild("TouchInterest")) then
            if Toggles.ItemESP or Toggles.WeaponESP then
                applyHighlight(obj, Color3.fromRGB(255, 255, 0), "Item")
            else
                removeHighlight(obj, "Item")
            end
        end
    end

    -- Character Speed & Jump Modification
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
        local humanoid = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if Toggles.WalkSpeed then
            humanoid.WalkSpeed = Settings.WalkSpeed
        end
        if Toggles.JumpPower then
            humanoid.UseJumpPower = true
            humanoid.JumpPower = Settings.JumpPower
        end
    end

    -- Camera Aimbot Locking
    if Toggles.Aimbot then
        local targetHead = getClosestTarget()
        if targetHead then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetHead.Position)
        end
    end
end)
