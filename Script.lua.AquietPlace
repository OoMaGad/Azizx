---------------------------------------------------------
-- BACKGROUND LOOP
---------------------------------------------------------
Workspace.DescendantAdded:Connect(function(obj)
    if Toggles.InstantInteract and obj:IsA("ProximityPrompt") then
        obj.HoldDuration = 0
        obj.RequiresLineOfSight = false
    end
end)

task.spawn(function()
    while task.wait(0.5) do
        if Toggles.InstantInteract then
            for _, prompt in ipairs(Workspace:GetDescendants()) do
                if prompt:IsA("ProximityPrompt") then
                    prompt.HoldDuration = 0
                    prompt.RequiresLineOfSight = false
                end
            end
        end

        local tempMonsters = {}
        local tempItems = {}

        for _, obj in ipairs(Workspace:GetDescendants()) do
            if Toggles.MonsterESP or Toggles.MonsterAimbot then
                if isMonster(obj) then tempMonsters[obj] = true end
            end
            if Toggles.ItemESP then
                local isMatch, label = getFilteredItem(obj)
                if isMatch then tempItems[obj] = label end
            end
        end

        CachedMonsters = tempMonsters
        CachedItems = tempItems
    end
end)

---------------------------------------------------------
-- RENDER LOOP
---------------------------------------------------------
RunService.RenderStepped:Connect(function()
    if Toggles.FOVVisible then
        local vp = Camera.ViewportSize
        FOVBox.Visible = true
        FOVBox.Size = UDim2.new(0, Settings.FOVRadius * 2, 0, Settings.FOVRadius * 2)
        FOVBox.Position = UDim2.new(0, vp.X / 2, 0, vp.Y / 2)
    else
        FOVBox.Visible = false
    end

    if Settings.CameraFOV then
        Camera.FieldOfView = Settings.CameraFOV
    end

    if Toggles.PlayerESP then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                applyESP(player.Character, Color3.fromRGB(0, 255, 0), player.Name, "Player")
            end
        end
    else
        for _, player in ipairs(Players:GetPlayers()) do
            if player.Character then removeESP(player.Character, "Player") end
        end
    end

    if Toggles.MonsterESP then
        for monster, _ in pairs(CachedMonsters) do
            if monster and monster.Parent then
                applyESP(monster, Color3.fromRGB(255, 0, 0), "Monster", "Monster")
            end
        end
    end

    if Toggles.ItemESP then
        for item, labelName in pairs(CachedItems) do
            if item and item.Parent then
                applyESP(item, Color3.fromRGB(255, 255, 0), labelName, "Item")
            end
        end
    end

    if Toggles.WalkSpeed and LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum.WalkSpeed = Settings.WalkSpeed end
    end

    if Toggles.MonsterAimbot or Toggles.PlayerAimbot then
        local closestPart = nil
        local shortestDistance = Settings.FOVRadius
        local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

        if Toggles.MonsterAimbot then
            for monster, _ in pairs(CachedMonsters) do
                local targetPart = monster:FindFirstChild("Head") or monster:FindFirstChild("HumanoidRootPart")
                if targetPart then
                    local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                    if onScreen then
                        local mouseDist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                        if mouseDist < shortestDistance then
                            shortestDistance = mouseDist
                            closestPart = targetPart
                        end
                    end
                end
            end
        end

        if Toggles.PlayerAimbot then
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character then
                    local targetPart = player.Character:FindFirstChild("Head") or player.Character:FindFirstChild("HumanoidRootPart")
                    if targetPart then
                        local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                        if onScreen then
                            local mouseDist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                            if mouseDist < shortestDistance then
                                shortestDistance = mouseDist
                                closestPart = targetPart
                            end
                        end
                    end
                end
            end
        end

        if closestPart then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, closestPart.Position)
        end
    end
end)
