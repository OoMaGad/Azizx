UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if input.KeyCode == Enum.KeyCode.E and not gameProcessed then
        Config.Aimbot = not Config.Aimbot
    end
end)

-- Anti-AFK Connection Logic
LocalPlayer.Idled:Connect(function()
    if Config.AntiAFK then
        pcall(function()
            VirtualUser:CaptureController()
            VirtualUser:ClickButton2(Vector2.new(0, 0))
        end)
    end
end)

local ESPCache = {}
local function getDrawing(target)
    if not Drawing or not Drawing.new then return nil end
    if not ESPCache[target] then
        local successTxt, txt = pcall(function()
            local t = Drawing.new("Text")
            t.Visible = false
            t.Center = true
            t.Outline = true
            t.OutlineColor = Color3.fromRGB(0, 0, 0)
            t.Font = 1
            t.Size = 10
            return t
        end)
        if successTxt then ESPCache[target] = txt end
    end
    return ESPCache[target]
end

local function getItemCategory(name)
    name = string.lower(name)
    if string.find(name, "battery") or string.find(name, "cell") or string.find(name, "power") then return "Battery"
    elseif string.find(name, "rocket launcher") or string.find(name, "launcher") or string.find(name, "flare gun") or string.find(name, "gun") or string.find(name, "rifle") or string.find(name, "pistol") or string.find(name, "shotgun") or string.find(name, "smg") or string.find(name, "knife") or string.find(name, "sword") or string.find(name, "bat") or string.find(name, "melee") or string.find(name, "weapon") or string.find(name, "revolver") or string.find(name, "sniper") or string.find(name, "axe") or string.find(name, "machete") or string.find(name, "crowbar") or string.find(name, "pipe") or string.find(name, "hammer") or string.find(name, "club") or string.find(name, "grenade") then return "Weapon"
    elseif string.find(name, "rocket") or string.find(name, "missile") or string.find(name, "flare pack") or string.find(name, "ammo") or string.find(name, "bullet") or string.find(name, "mag") or string.find(name, "round") or string.find(name, "shell") or string.find(name, "box") or string.find(name, "pack") then return "Ammo"
    elseif string.find(name, "med") or string.find(name, "bandage") or string.find(name, "heal") or string.find(name, "kit") or string.find(name, "pill") or string.find(name, "first") or string.find(name, "syringe") or string.find(name, "health") or string.find(name, "pain") or string.find(name, "tonic") or string.find(name, "gauze") then return "Medical"
    elseif string.find(name, "food") or string.find(name, "water") or string.find(name, "can") or string.find(name, "drink") or string.find(name, "apple") or string.find(name, "bottle") or string.find(name, "mre") or string.find(name, "soup") or string.find(name, "cola") then return "Food"
    else return "Other" end
end

local function isValidItemName(name)
    local low = string.lower(name)
    if string.find(low, "door") or string.find(low, "opener") or string.find(low, "gate") or string.find(low, "lever") or string.find(low, "switch") or string.find(low, "button") or string.find(low, "drawer") or string.find(low, "chest") or string.find(low, "desk") or string.find(low, "house") or string.find(low, "home") or string.find(low, "building") or string.find(low, "cabinet") or string.find(low, "cabin") or string.find(low, "shack") or string.find(low, "freezer") or string.find(low, "gasstation") then return false end
    return true
end

local scanTimer = 0
local cachedEntities = {}
local cachedItems = {}
local isJumpingOrFalling = false

local function hookFallDamage()
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.StateChanged:Connect(function(_, newState)
            if newState == Enum.HumanoidStateType.FallingDown or newState == Enum.HumanoidStateType.Ragdoll then
                hum:ChangeState(Enum.HumanoidStateType.GettingUp)
            end
        end)
    end
end

LocalPlayer.CharacterAdded:Connect(function(char)
    char:WaitForChild("Humanoid")
    hookFallDamage()
end)
hookFallDamage()

Workspace.DescendantAdded:Connect(function(obj)
    if obj:IsA("ProximityPrompt") and Config.InstantInteract then obj.HoldDuration = 0 end
end)

-- ==========================================
-- INFINITE STATS DEEP-SCAN ENGINE (Stamina, Water)
-- ==========================================
local foundWaterStats = {}
local foundStaminaStats = {}

task.spawn(function()
    while task.wait(5) do
        foundWaterStats = {}
        foundStaminaStats = {}
        
        local searchTargets = {LocalPlayer, LocalPlayer.Character}
        for _, target in ipairs(searchTargets) do
            if target then
                for _, obj in ipairs(target:GetDescendants()) do
                    if obj:IsA("ValueBase") then
                        local n = string.lower(obj.Name)
                        if string.find(n, "water") or string.find(n, "thirst") or string.find(n, "hydration") then
                            table.insert(foundWaterStats, obj)
                        elseif string.find(n, "stamina") or string.find(n, "energy") then
                            table.insert(foundStaminaStats, obj)
                        end
                    end
                end
            end
        end
    end
end)

RunService.Heartbeat:Connect(function()
    if Config.InfWater then
        for _, stat in ipairs(foundWaterStats) do
            pcall(function() 
                if type(stat.Value) == "number" and stat.Value < 100 then
                    stat.Value = 100
                end
            end)
        end
        pcall(function()
            local char = LocalPlayer.Character
            if char then
                if char:GetAttribute("Water") then char:SetAttribute("Water", 100) end
                if char:GetAttribute("Thirst") then char:SetAttribute("Thirst", 100) end
            end
            if LocalPlayer:GetAttribute("Water") then LocalPlayer:SetAttribute("Water", 100) end
            if LocalPlayer:GetAttribute("Thirst") then LocalPlayer:SetAttribute("Thirst", 100) end
        end)
    end

    if Config.InfStamina then
        for _, stat in ipairs(foundStaminaStats) do
            pcall(function() 
                if type(stat.Value) == "number" and stat.Value < 100 then
                    stat.Value = 100
                end
            end)
        end
        pcall(function()
            local char = LocalPlayer.Character
            if char and char:GetAttribute("Stamina") then char:SetAttribute("Stamina", 100) end
            if LocalPlayer:GetAttribute("Stamina") then LocalPlayer:SetAttribute("Stamina", 100) end
        end)
    end
end)

-- Safe Metatable Interception with pcall to stop crashes
pcall(function()
    local mt = getrawmetatable(game)
    if setreadonly then setreadonly(mt, false) end
    local oldNewIndex = mt.__newindex

    mt.__newindex = newcclosure(function(t, k, v)
        if not checkcaller() then
            if k == "Value" and type(v) == "number" and v < 100 then
                local success, n = pcall(function() return string.lower(t.Name) end)
                if success and n then
                    if Config.InfWater and (string.find(n, "water") or string.find(n, "thirst") or string.find(n, "hydration")) then
                        return oldNewIndex(t, k, 100)
                    elseif Config.InfStamina and (string.find(n, "stamina") or string.find(n, "energy")) then
                        return oldNewIndex(t, k, 100)
                    end
                end
            end
        end
        return oldNewIndex(t, k, v)
    end)
    if setreadonly then setreadonly(mt, true) end
end)

-- ==========================================
-- MAIN RENDER STEP LOOP (Optimized for Zero Lag)
-- ==========================================
RunService.RenderStepped:Connect(function(dt)
    scanTimer = scanTimer + dt
    if scanTimer >= 2.5 then
        scanTimer = 0
        cachedEntities = {}
        cachedItems = {}
        
        pcall(function()
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if obj:IsA("Model") then
                    local hum = obj:FindFirstChildOfClass("Humanoid")
                    if hum then
                        local p = Players:GetPlayerFromCharacter(obj)
                        if p and p ~= LocalPlayer then
                            table.insert(cachedEntities, {type = "Player", model = obj, name = p.Name})
                        elseif not p then
                            local nLow = string.lower(obj.Name)
                            if nLow ~= "camera" and not string.find(nLow, "item") then
                                table.insert(cachedEntities, {type = "Monster", model = obj, name = obj.Name})
                            end
                        end
                    end
                end
            end

            for _, obj in ipairs(Workspace:GetDescendants()) do
                if obj:IsA("ProximityPrompt") then
                    if Config.InstantInteract then obj.HoldDuration = 0 end
                    
                    local itemParent = obj.Parent
                    while itemParent and itemParent ~= Workspace do
                        if itemParent:IsA("Model") then
                            local realName = itemParent.Name
                            if isValidItemName(realName) then
                                local primary = itemParent.PrimaryPart or itemParent:FindFirstChildWhichIsA("BasePart")
                                if primary and realName ~= "Workspace" then
                                    table.insert(cachedItems, {part = primary, name = realName, cat = getItemCategory(realName)})
                                    break
                                end
                            end
                        end
                        itemParent = itemParent.Parent
                    end
                end
            end
        end)
    end

    local closestTarget = nil
    local shortestDist = math.huge
    local activeDrawings = {}

    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hum and hrp then
            if Config.SpeedHack then
                hum.WalkSpeed = Config.WalkSpeed
                local moveDir = hum.MoveDirection
                if moveDir.Magnitude > 0 then
                    local currentVel = hrp.AssemblyLinearVelocity
                    hrp.AssemblyLinearVelocity = Vector3.new(moveDir.X * Config.WalkSpeed, currentVel.Y, moveDir.Z * Config.WalkSpeed)
                end
            end
            
            if Config.JumpHack then
                hum.UseJumpPower = true
                hum.JumpPower = Config.JumpPower

                if hum:GetState() == Enum.HumanoidStateType.Jumping or hum:GetState() == Enum.HumanoidStateType.Freefall then
                    isJumpingOrFalling = true
                elseif isJumpingOrFalling then
                    if hum.FloorMaterial ~= Enum.Material.Air then
                        isJumpingOrFalling = false
                    else
                        local vel = hrp.AssemblyLinearVelocity
                        if vel.Y < -100 then
                            hrp.AssemblyLinearVelocity = Vector3.new(vel.X, -50, vel.Z)
                        end
                    end
                end
            end
        end
    end

    for _, entity in ipairs(cachedEntities) do
        pcall(function()
            local model = entity.model
            local hrp = model and model:FindFirstChild("HumanoidRootPart") or (model and model:FindFirstChildWhichIsA("BasePart"))
            local hum = model and model:FindFirstChildOfClass("Humanoid")
            
            if hrp and hum and hum.Health > 0 then
                local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                if onScreen then
                    local dist = (Camera.CFrame.Position - hrp.Position).Magnitude
                    local showPlr = (entity.type == "Player" and Config.PlayerESP)
                    local showMon = (entity.type == "Monster" and Config.MonsterESP)

                    if showPlr or showMon then
                        local txt = getDrawing(model)
                        if txt then
                            activeDrawings[model] = true
                            txt.Visible = true
                            txt.Position = Vector2.new(pos.X, pos.Y)
                            
                            if entity.type == "Player" then
                                txt.Text = string.format("[Player] %s [%dm]", entity.name, math.floor(dist))
                                txt.Color = Color3.fromRGB(80, 200, 255)
                            else
                                txt.Text = string.format("[Monster] %s [%dm]", entity.name, math.floor(dist))
                                txt.Color = Color3.fromRGB(255, 50, 50)
      
