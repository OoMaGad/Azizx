-- Configuration System Setup
local ConfigFileName = "default.json"
local ConfigsFolder = "KazuHub_Configs"

if not isfolder then
    getgenv().isfolder = function() return true end
    getgenv().makefolder = function() end
    getgenv().writefile = function() end
    getgenv().readfile = function() return "{}" end
    getgenv().listfiles = function() return {} end
end

if not isfolder(ConfigsFolder) then
    makefolder(ConfigsFolder)
end

-- Load Obsidian Library
local successLib, Library = pcall(function()
    return loadstring(game:HttpGet("https://raw.githubusercontent.com/deividcomsono/Obsidian/refs/heads/main/Library.lua"))()
end)

if not successLib or not Library then
    warn("[Kazu Hub] Failed to load Obsidian library.")
    return
end

-- State Variables
local Toggles = {
    PlayerESP = false,
    MonsterESP = false,
    ItemESP = false,
    MedicalESP = true,
    WeaponESP = true,
    ObjectiveESP = true,
    NoiseESP = true,
    FoodESP = true,
    MonsterAimbot = false,
    PlayerAimbot = false,
    FOVVisible = false,
    WalkSpeed = false,
    InstantInteract = true,
    AntiAFK = true
}

local Settings = {
    FOVRadius = 200,
    WalkSpeed = 30,
    CameraFOV = 70,
    DiscordWebhook = "https://discord.com/api/webhooks/1532342380722782349/sOcdaPAqhYZF_xVwWXm8gbq1b11w79_LqHZCLFpnaM_-4LqusulVA5kQENJX92g57Va1"
}

local CachedMonsters = {}
local CachedItems = {}
local FeedbackText = ""
local SelectedConfigName = "default.json"

-- Save and Load Functions
local function SaveConfig(name)
    local targetFile = ConfigsFolder .. "/" .. (name ~= "" and name or ConfigFileName)
    local success, err = pcall(function()
        local data = {
            Toggles = Toggles,
            Settings = Settings
        }
        writefile(targetFile, HttpService:JSONEncode(data))
    end)
    if success then
        Library:Notify("Configuration saved successfully!", 4)
    else
        Library:Notify("Failed to save configuration!", 4)
    end
end

local function LoadConfig(name)
    local targetFile = ConfigsFolder .. "/" .. (name ~= "" and name or ConfigFileName)
    local success, err = pcall(function()
        if readfile and pcall(readfile, targetFile) then
            local decoded = HttpService:JSONDecode(readfile(targetFile))
            if decoded.Toggles then
                for k, v in pairs(decoded.Toggles) do
                    Toggles[k] = v
                end
            end
            if decoded.Settings then
                for k, v in pairs(decoded.Settings) do
                    Settings[k] = v
                end
            end
        end
    end)
    if success then
        Library:Notify("Configuration auto-loaded successfully!", 4)
    end
end

-- Auto load default config right away on script execution
pcall(function()
    LoadConfig("default.json")
end)

local Window = Library:CreateWindow({
    Title = "Kazu Hub",
    Footer = "v1.0.0 - Delta Compatible",
