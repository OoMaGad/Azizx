-- Services
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
local Camera = Workspace.CurrentCamera

-- Load Rayfield UI
local Rayfield = loadstring(game:HttpGet("https://sirius.menu/rayfield"))()

local Window = Rayfield:CreateWindow({
    Name = "A Quiet Place: Deadzone Hub",
    LoadingTitle = "Loading System...",
    ConfigurationSaving = { Enabled = false },
    KeySystem = false
})

-- Welcome Notification & Credits
Rayfield:Notify({
    Title = "Welcome!",
    Content = "Credit to Aziz | Script Loaded Successfully!",
    Duration = 6.5,
    Image = 4483362458,
    Actions = {
        Ignore = {
            Name = "Okay",
            Callback = function()
                print("Welcome notification acknowledged.")
            end
        },
    },
})

-- State Variables
local Toggles = {
    PlayerESP = false,
    MonsterESP = false,
    ItemESP = false,
    -- Specific Item Category Toggles
    MedicalESP = true,
    WeaponESP = true,
    ObjectiveESP = true,
    NoiseESP = true,
    Aimbot = false,
    FOVVisible = false,
    WalkSpeed = false
}

local Settings = {
    FOVRadius = 200,
    WalkSpeed = 30
}

-- Caches
local CachedMonsters = {}
local CachedItems = {}

---------------------------------------------------------
-- UI TABS
---------------------------------------------------------

local CombatTab = Window:CreateTab("Combat", 4483362458)
local ESPTab = Window:CreateTab("ESP", 4483362458)
local MovementTab = Window:CreateTab("Movement", 4483362458)

-- 1. COMBAT
CombatTab:CreateToggle({
    Name = "Monster Aimbot",
    CurrentValue = false,
    Callback = function(Value) Toggles.Aimbot = Value end
})

CombatTab:CreateToggle({
    Name = "Show FOV Circle",
    CurrentValue = false,
    Callback = function(Value) Toggles.FOVVisible = Value end
})

CombatTab:CreateSlider({
    Name = "Aimbot FOV Radius",
    Range = {50, 500},
    Increment = 10,
    CurrentValue = 200,
    Callback = function(Value) Settings.FOVRadius = Value end
})

-- 2. ESP
ESPTab:CreateSection("Entities")

ESPTab:CreateToggle({
    Name = "Player ESP (Green)",
    CurrentValue = false,
    Callback = function(Value) Toggles.PlayerESP = Value end
})

ESPTab:CreateToggle({
    Name = "Monster ESP (Red)",
    CurrentValue = false,
    Callback = function(Value) 
        Toggles.MonsterESP = Value 
        if not Value then
            for obj, _ in pairs(CachedMonsters) do removeESP(obj, "Monster") end
        end
    end
})

ESPTab:CreateSection("Loot & Items")

ESPTab:CreateToggle({
    Name = "Item / Loot ESP (Yellow)",
    CurrentValue = false,
    Callback = function(Value) 
        Toggles.ItemESP = Value 
        if not Value then
            for obj, _ in pairs(CachedItems) do removeESP(obj, "Item") end
        end
    end
})

ESPTab:CreateToggle({
    Name = "  └ Medical (Meds/Bandages)",
    CurrentValue = true,
    Callback = function(Value) Toggles.MedicalESP = Value end
})

ESPTab:CreateToggle({
    Name = "  └ Weapons & Ammo",
    CurrentValue = true,
    Callback = function(Value) Toggles.WeaponESP = Value end
})

ESPTab:CreateToggle({
    Name = "  └ Objectives (Fuses/Keys/Gears)",
    CurrentValue = true,
    Callback = function(Value) Toggles.ObjectiveESP = Value end
})

ESPTab:CreateToggle({
    Name = "  └ Noise & Distractions",
    CurrentValue = true,
    Callback = function(Value) Toggles.NoiseESP = Value end
})

-- 3. MOVEMENT
MovementTab:CreateToggle({
    Name = "Speed Hack",
    CurrentValue = false,
    Callback = function(Value) Toggles.WalkSpeed = Value end
})

MovementTab:CreateSlider({
    Name = "WalkSpeed",
    Range = {16, 100},
    Increment = 1,
    CurrentValue = 30,
    Callback = function(Value) Settings.WalkSpeed = Value end
})

---------------------------------------------------------
-- CORE FUNCTIONS
---------------------------------------------------------

local FOVCircle = Drawing.new("Circle")
FOVCircle.Color = Color3.fromRGB(255, 0, 0)
FOVCircle.Thickness = 1.5
FOVCircle.NumSides = 64
FOVCircle.Filled = false
FOVCircle.Transparency = 1

function applyESP(model, color, displayName, tagType)
    if not model or not model.Parent then return end
    
    local hlName = tagType .. "_ESP"
    local tagName = tagType .. "_Tag"

    local hl = model:FindFirstChild(hlName)
    if not hl then
        hl = Instance.new("Highlight")
        hl.Name = hlName
        hl.FillColor = color
        hl.FillTransparency = 0.4
        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
        hl.OutlineTransparency = 0
        hl.Parent = model
    end

    local targetPart = model:FindFirstChild("Head") 
        or model:FindFirstChild("HumanoidRootPart") 
        or model:FindFirstChild("PrimaryPart")
        or model:FindFirstChild("Handle") 
        or (model:IsA("BasePart") and model)
        or model:FindFirstChildOfClass("BasePart")

    if not targetPart then return end

    local bb = model:FindFirstChild(tagName)
    if not bb then
        bb = Instance.new("BillboardGui")
        bb.Name = tagName
        bb.Adornee = targetPart
        bb.Size = UDim2.new(0, 150, 0, 30)
        bb.StudsOffset = Vector3.new(0, 2.5, 0)
        bb.AlwaysOnTop = true
        
        local label = Instance.new("TextLabel")
        label.Name = "Text"
        label.Parent = bb
        label.BackgroundTransparency = 1
        label.Size = UDim2.new(1, 0, 1, 0)
        label.TextColor3 = color
        label.TextStrokeTransparency = 0
        label.TextSize = 13
        label.Font = Enum.Font.SourceSansBold
        
        bb.Parent = model
    end

    if bb and bb:FindFirstChild("Text") and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local dist = math.floor((LocalPlayer.Character.HumanoidRootPart.Position - targetPart.Position).Magnitude)
        bb.Text.Text = displayName .. " [" .. tostring(dist) .. "m]"
    end
end

function removeESP(model, tagType)
    if not model then return end
    local hl = model:FindFirstChild(tagType .. "_ESP")
    if hl then hl:Destroy() end
    
    local bb = model:FindFirstChild(tagType .. "_Tag")
    if bb then bb:Destroy() end
end

-- Monster Check
local function isMonster(obj)
    if not obj:IsA("Model") or Players:GetPlayerFromCharacter(obj) then return false end
    local nameLower = obj.Name:lower()
    if nameLower:find("monster") or nameLower:find("creature") or nameLower:find("angel") or nameLower:find("alien") or nameLower:find("death") or nameLower:find("beast") or obj:FindFirstChildOfClass("Humanoid") then
        return true
    end
    return false
end

-- Filtered Item Checker
local function getFilteredItem(obj)
    if Players:GetPlayerFromCharacter(obj) or isMonster(obj) then return false, nil end

    local nameLower = obj.Name:lower()
    local promptText = ""
    local prompt = obj:FindFirstChildOfClass("ProximityPrompt")
    if prompt then
        promptText = (prompt.ObjectText .. " " .. prompt.ActionText):lower()
    end

    local checkStr = nameLower .. " " .. promptText

    -- Medical
    if Toggles.MedicalESP and (checkStr:find("med") or checkStr:find("bandage") or checkStr:find("health")) then
        return true, "Medical"
    end

    -- Weapons / Ammo
    if Toggles.WeaponESP and (checkStr:find("gun") or checkStr:find("ammo") or checkStr:find("shotgun") or checkStr:find("rifle") or checkStr:find("pistol") or checkStr:find("weapon") or obj:IsA("Tool")) then
        return true, obj.Name
    end

    -- Objectives
    if Toggles.ObjectiveESP and (checkStr:find("fuse") or checkStr:find("key") or checkStr:find("card") or checkStr:find("battery") or checkStr:find("part") or checkStr:find("gear")) then
        return true, obj.Name
    end

    -- Noise / Distractions
    if Toggles.NoiseESP and (checkStr:find("radio") or checkStr:find("flare") or checkStr:find("noise") or checkStr:find("bottle") or checkStr:find("can")) then
        return true, obj.Name
    end

    return false, nil
end

---------------------------------------------------------
-- BACKGROUND SCANNER (Runs every 1.5 seconds)
---------------------------------------------------------

task.spawn(function()
    while task.wait(1.5) do
        if Toggles.MonsterESP or Toggles.ItemESP or Toggles.Aimbot then
            local tempMonsters = {}
            local tempItems = {}

            for _, obj in ipairs(Workspace:GetDescendants()) do
                if Toggles.MonsterESP or Toggles.Aimbot then
                    if isMonster(obj) then tempMonsters[obj] = true end
                end

                if Toggles.ItemESP then
                    local isMatch, label = getFilteredItem(obj)
                    if isMatch then tempItems[obj] = label end
                end
            end

            CachedMonsters = tempMonsters
            CachedItems = tempItems
        end
    end
end)

---------------------------------------------------------
-- RENDER LOOP
---------------------------------------------------------

RunService.RenderStepped:Connect(function()
    FOVCircle.Visible = Toggles.FOVVisible
    FOVCircle.Radius = Settings.FOVRadius
    FOVCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    -- Player ESP
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            if Toggles.PlayerESP then
                applyESP(player.Character, Color3.fromRGB(0, 255, 0), player.Name, "Player")
            else
                removeESP(player.Character, "Player")
            end
        end
    end

    -- Monster ESP
    if Toggles.MonsterESP then
        for monster, _ in pairs(CachedMonsters) do
            if monster and monster.Parent then
                applyESP(monster, Color3.fromRGB(255, 0, 0), "Monster (" .. monster.Name .. ")", "Monster")
            end
        end
    end

    -- Item ESP
    if Toggles.ItemESP then
        for item, labelName in pairs(CachedItems) do
            if item and item.Parent then
                applyESP(item, Color3.fromRGB(255, 255, 0), labelName, "Item")
            else
                removeESP(item, "Item")
            end
        end
    end

    -- Speed Hack
    if Toggles.WalkSpeed and LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
        LocalPlayer.Character:FindFirstChildOfClass("Humanoid").WalkSpeed = Settings.WalkSpeed
    end

    -- Monster Aimbot
    if Toggles.Aimbot then
        local closestPart = nil
        local shortestDistance = Settings.FOVRadius
        local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

        for monster, _ in pairs(CachedMonsters) do
            if monster and monster.Parent then
                local targetPart = monster:FindFirstChild("Head") or monster:FindFirstChild("HumanoidRootPart") or monster:FindFirstChildOfClass("BasePart")
                if targetPart then
                    local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                    if onScreen then
                        local mouseDist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                        if mouseDist < shortestDistance then
                            shortestDistance = mouseDist
                            closestPart = targetPart
                        end
                    end
                end
            end
        end

        if closestPart then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, closestPart.Position)
        end
    end
end)
