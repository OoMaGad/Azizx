-- Services
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local VirtualUser = game:GetService("VirtualUser")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local LocalPlayer = Players.LocalPlayer

-- Load Rayfield UI (Stable & fully working execution on mobile & PC)
local Rayfield = loadstring(game:HttpGet("https://sirius.menu/rayfield"))()

local Window = Rayfield:CreateWindow({
    Name = "A Quiet Place | Survival Hub",
    LoadingTitle = "Initializing Stealth Modules...",
    LoadingSubtitle = "By Kazuto",
    ConfigurationSaving = { Enabled = false },
    KeySystem = false
})

Rayfield:Notify({
    Title = "Hub Loaded",
    Content = "Welcome back, Kazuto! A Quiet Place survival hub active.",
    Duration = 5,
    Image = 4483362458
})

-- State Configuration for A Quiet Place
local Config = {
    AntiAFK = true,
    StealthMode = false,
    WalkSpeed = 16,
    Fullbright = false,
    MonsterESP = false,
    PlayerESP = false,
    AutoLoot = false,
    SafeZoneTeleport = false
}

---------------------------------------------------------
-- TABS SETUP
---------------------------------------------------------
local SurvivalTab = Window:CreateTab("Survival & Stealth", 4483362458)
local VisualsTab = Window:CreateTab("Visuals & ESP", 4483362458)
local UtilityTab = Window:CreateTab("Utility & AFK", 4483362458)

---------------------------------------------------------
-- 1. SURVIVAL & STEALTH TAB
---------------------------------------------------------
SurvivalTab:CreateSection("Movement & Stealth")

SurvivalTab:CreateToggle({
    Name = "Stealth Mode (Mute Footsteps & Noise)",
    CurrentValue = false,
    Callback = function(v)
        Config.StealthMode = v
        Rayfield:Notify({Title = "Stealth", Content = "Stealth Status: " .. tostring(v), Duration = 2})
    end
})

SurvivalTab:CreateSlider({
    Name = "WalkSpeed Modifier",
    Range = {10, 100},
    Increment = 1,
    Suffix = "Speed",
    CurrentValue = 16,
    Flag = "SliderWS",
    Callback = function(v)
        Config.WalkSpeed = v
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
            LocalPlayer.Character.Humanoid.WalkSpeed = v
        end
    end
})

SurvivalTab:CreateToggle({
    Name = "Auto-Loot Nearby Items / Supplies",
    CurrentValue = false,
    Callback = function(v)
        Config.AutoLoot = v
    end
})

---------------------------------------------------------
-- 2. VISUALS & ESP TAB
---------------------------------------------------------
VisualsTab:CreateSection("Lighting & Tracking")

VisualsTab:CreateToggle({
    Name = "Fullbright (See in Dark Areas)",
    CurrentValue = false,
    Callback = function(v)
        Config.Fullbright = v
        if not v then
            game:GetService("Lighting").Brightness = 1
            game:GetService("Lighting").ClockTime = 0
            game:GetService("Lighting").FogEnd = 1000
            game:GetService("Lighting").GlobalShadows = true
        end
    end
})

VisualsTab:CreateToggle({
    Name = "Monster ESP (Highlight Creatures)",
    CurrentValue = false,
    Callback = function(v)
        Config.MonsterESP = v
    end
})

VisualsTab:CreateToggle({
    Name = "Player ESP",
    CurrentValue = false,
    Callback = function(v)
        Config.PlayerESP = v
    end
})

---------------------------------------------------------
-- 3. UTILITY & AFK TAB
---------------------------------------------------------
UtilityTab:CreateSection("Safety Features")

UtilityTab:CreateToggle({
    Name = "Anti-AFK Protection",
    CurrentValue = true,
    Callback = function(v)
        Config.AntiAFK = v
    end
})

---------------------------------------------------------
-- BACKGROUND WORKER LOOPS
---------------------------------------------------------

-- Anti-AFK Connection
LocalPlayer.Idled:Connect(function()
    if Config.AntiAFK then
        VirtualUser:Button2Down(Vector2.new(0, 0), workspace.CurrentCamera.CFrame)
        task.wait(1)
        VirtualUser:Button2Up(Vector2.new(0, 0), workspace.CurrentCamera.CFrame)
    end
end)

-- Main Automation & Survival Loop
task.spawn(function()
    while true do
        task.wait(0.5)
        pcall(function()
            -- 1. Maintain WalkSpeed & Stealth Footstep Muter
            if LocalPlayer.Character then
                local humanoid = LocalPlayer.Character:FindFirstChild("Humanoid")
                if humanoid then
                    humanoid.WalkSpeed = Config.WalkSpeed
                end

                if Config.StealthMode then
                    for _, obj in ipairs(LocalPlayer.Character:GetDescendants()) do
                        if obj:IsA("Sound") and obj.Playing then
                            obj.Volume = 0
                        end
                    end
                end
            end

            -- 2. Fullbright Lighting Hook
            if Config.Fullbright then
                local lighting = game:GetService("Lighting")
                lighting.Brightness = 2
                lighting.ClockTime = 14
                lighting.FogEnd = 100000
                lighting.GlobalShadows = false
            end

            -- 3. Auto-Loot Supplies / Interaction Prompts
            if Config.AutoLoot then
                for _, obj in ipairs(Workspace:GetDescendants()) do
                    if obj:IsA("ProximityPrompt") then
                        if obj.Parent and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                            local distance = (LocalPlayer.Character.HumanoidRootPart.Position - obj.Parent.Position).Magnitude
                            if distance <= obj.MaxActivationDistance then
                                fireproximityprompt(obj)
                            end
                        end
                    end
                end
            end

            -- 4. Player ESP Loop
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character then
                    local highlight = player.Character:FindFirstChild("PlayerESP")
                    if Config.PlayerESP then
                        if not highlight then
                            highlight = Instance.new("Highlight")
                            highlight.Name = "PlayerESP"
                            highlight.FillColor = Color3.fromRGB(0, 255, 0)
                            highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                            highlight.Parent = player.Character
                        end
                    else
                        if highlight then highlight:Destroy() end
                    end
                end
            end

            -- 5. Monster / Creature ESP Loop
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and not Players:GetPlayerFromCharacter(obj) then
                    local highlight = obj:FindFirstChild("MonsterESP")
                    if Config.MonsterESP then
                        if not highlight then
                            highlight = Instance.new("Highlight")
                            highlight.Name = "MonsterESP"
                            highlight.FillColor = Color3.fromRGB(255, 0, 0)
                            highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                            highlight.Parent = obj
                        end
                    else
                        if highlight then highlight:Destroy() end
                    end
                end
            end
        end)
    end
end)
